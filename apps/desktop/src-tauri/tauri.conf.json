{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Masthead",
  "version": "0.1.0",
  "identifier": "app.masthead.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Masthead",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "visible": false
      },
      {
        "label": "notch",
        "title": "Masthead notch",
        "url": "notch.html",
        "width": 440,
        "height": 420,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Monitor your AI coding agents at a glance",
    "longDescription": "Masthead watches your AI coding agent sessions (Claude Code, Codex, Antigravity) from the logs they keep on your machine, and shows them in a liquid-glass app and a notch at the top of the screen.",
    "publisher": "Masthead contributors",
    "copyright": "Copyright (c) Masthead contributors. MIT License.",
    "license": "MIT",
    "homepage": "https://github.com/gufran21/masthead",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
